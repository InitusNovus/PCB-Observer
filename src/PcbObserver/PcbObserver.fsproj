<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Capture.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Sch.fs" />
    <Compile Include="SchPipeline.fs" />
    <Compile Include="Watch.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="ObserverSession.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="viewer.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="viewer-sch.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
